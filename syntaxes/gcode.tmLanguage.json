{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "G-Code",
  "scopeName": "source.gcode",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#macrovars"
    },
    {
      "include": "#control"
    },
    {
      "include": "#gcodes"
    },
    {
      "include": "#mcodes"
    },
    {
      "include": "#prognumbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#speedsfeeds"
    },
    {
      "include": "#coords"
    },
    {
      "include": "#tools"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#rs274ngc"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block",
          "match": "(\\(.+?\\))"
        },
        {
          "name": "comment.line",
          "begin": ";",
          "end": "\\n"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "match": "(?i)(GOTO\\s?\\d+)",
          "name": "keyword.control"
        },
        {
          "match": "(?i)\\b(DO\\s?\\d*|WHILE|WH|END|IF|ELSEIF|THEN|ELSE|ENDIF)\\b",
          "name": "keyword.control"
        },
        {
          "match": "([\\%])",
          "name": "punctuation.definition"
        }
      ]
    },
    "gcodes": {
      "patterns": [
        {
          "match": "(?i)([G])([0-9]{1,3})(\\.[0-9])?",
          "name": "entity.name.function"
        }
      ]
    },
    "mcodes": {
      "patterns": [
        {
          "match": "(?i)([M])([0-9]{1,3})",
          "name": "entity.name.function"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(?i)(SIN|COS|TAN|ASIN|ACOS|ATAN|FIX|FUP|LN|ROUND|SQRT|ABS|MOD|MIN|MAX)",
          "name": "support.function"
        },
        {
          "match": "(\\+|\\-|\\*|\\/|\\*\\*|\\=)",
          "name": "keyword.operator"
        },
        {
          "match": "(?i)\\b(GT|LT|EQ|NE|LE|GE|AND|OR|XOR|MOD)\\b",
          "name": "keyword.operator"
        }
      ]
    },
    "speedsfeeds": {
      "patterns": [
        {
          "match": "(?i)([S])\\s?(\\d+|(?=[#\\[]))",
          "captures": {
            "1": {
              "name": "variable.parameter"
            },
            "2": {
              "name": "constant.numeric"
            }
          },
          "name": "variable.parameter"
        },
        {
          "match": "(?i)([EF])\\s?\\.?(\\d+(\\.\\d*)?|(?=[#\\[]))",
          "name": "variable.parameter"
        }
      ]
    },
    "prognumbers": {
      "patterns": [
        {
          "match": "(?i)(^[N])(\\d+)",
          "name": "entity.name.label"
        },
        {
          "match": "(?i)(^|\\s)([O]\\d+)",
          "captures": {
            "2": {
              "name": "entity.name.label"
            }
          }
        }
      ]
    },
    "coords": {
      "patterns": [
        {
          "match": "(?i)([ABCXYZUVWIJK])\\s?(\\-?\\d*\\.?\\d+\\.?|\\-?\\.?(?=[#\\[]))",
          "captures": {
            "1": {
              "name": "variable.parameter"
            },
            "2": {
              "name": "constant.numeric"
            }
          },
          "name": "variable.parameter"
        }
      ]
    },
    "tools": {
      "patterns": [
        {
          "match": "(?i)([DHT])\\s?(\\d+(\\.\\d*)?|(?=[#\\[]))",
          "captures": {
            "1": {
              "name": "variable.parameter"
            },
            "2": {
              "name": "constant.numeric"
            }
          },
          "name": "variable.parameter"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?i)(\\d+(\\.\\d*)?)",
          "name": "constant.numeric"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "match": "(?i)([QRP])(\\-?\\d*\\.?\\d+\\.?|\\-?\\.?(?=[#\\[]))",
          "captures": {
            "1": {
              "name": "variable.parameter"
            },
            "2": {
              "name": "constant.numeric"
            }
          },
          "name": "variable.parameter"
        }
      ]
    },
    "macrovars": {
      "patterns": [
        {
          "match": "[#]([0-9]+)",
          "captures": {
            "1": {
              "name": "variable.name"
            }
          },
          "name": "variable.other.readwrite"
        },
        {
          "match": "[#][<]([a-zA-Z0-9_]+)[>]",
          "captures": {
            "1": {
              "name": "variable.name"
            }
          },
          "name": "variable.other.readwrite"
        },
        {
          "match": "[#]\\[",
          "name": "variable.other.readwrite"
        }
      ]
    },
    "rs274ngc": {
      "patterns": [
        {
          "match": "(?i)(ENDSUB|SUB)",
          "name": "keyword.control"
        },
        {
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition"
            }
          },
          "name": "meta.tag"
        }
      ]
    }
  }
}
