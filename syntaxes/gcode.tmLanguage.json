{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "G-Code",
  "scopeName": "source.gcode",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#control"
    },
    {
      "include": "#gcodes"
    },
    {
      "include": "#mcodes"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#speedsfeeds"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#prognumbers"
    },
    {
      "include": "#coords"
    },
    {
      "include": "#tools"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#macrovars"
    },
    {
      "include": "#rs274ngc"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.gcode",
          "match": "(\\(.+?\\))"
        },
        {
          "name": "comment.line.gcode",
          "begin": ";",
          "end": "\\n"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "match": "(?i)(GOTO\\s?\\d+)",
          "name": "keyword.control.gcode"
        },
        {
          "match": "(?i)(EQ|NE|LT|GT|LE|GE|AND|OR|XOR)",
          "name": "keyword.operator.logical.gcode"
        },
        {
          "match": "(?i)(DO\\s?\\d*|WHILE|WH|END|IF|ELSEIF|THEN|ELSE|ENDIF)",
          "name": "keyword.control.gcode"
        },
        {
          "match": "([\\%])",
          "name": "punctuation.definition.program.gcode"
        }
      ]
    },
    "gcodes": {
      "patterns": [
        {
          "match": "(?i)([G])(1)?5[4-9](.1)?\\s?(P[0-9]{1,3})?",
          "name": "entity.name.function.gcode"
        },
        {
          "match": "(?i)([G])1[1-2][0-9]",
          "name": "entity.name.function.gcode"
        },
        {
          "match": "(?i)([G])15\\s?(H[0-9]{1,2})?",
          "name": "entity.name.function.gcode"
        },
        {
          "match": "(?i)([G])([0-9]{1,3})(\\.[0-9])?",
          "name": "entity.name.function.gcode"
        }
      ]
    },
    "mcodes": {
      "patterns": [
        {
          "match": "(?i)([M])([0-9]{1,3})",
          "name": "entity.name.function.mcode"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(?i)(SIN|COS|TAN|ASIN|ACOS|ATAN|FIX|FUP|LN|ROUND|SQRT|ABS|MOD|MIN|MAX)",
          "name": "support.function.math.gcode"
        },
        {
          "match": "(\\+|\\-|\\*|\\/|\\*\\*|\\=)",
          "name": "keyword.operator.arithmetic.gcode"
        }
      ]
    },
    "speedsfeeds": {
      "patterns": [
        {
          "match": "(?i)([S])\\s?(\\d+|(?=[#\\[]))",
          "captures": {
            "1": {
              "name": "variable.parameter.gcode"
            },
            "2": {
              "name": "constant.numeric.gcode"
            }
          },
          "name": "variable.parameter.gcode"
        },
        {
          "match": "(?i)([EF])\\s?\\.?(\\d+(\\.\\d*)?|(?=[#\\[]))",
          "name": "variable.parameter.gcode"
        }
      ]
    },
    "prognumbers": {
      "patterns": [
        {
          "match": "(?i)(^[N])(\\d+)",
          "name": "entity.name.label.gcode"
        },
        {
          "match": "(?i)(^[O])(\\d+)?",
          "name": "meta.tag.gcode"
        },
        {
          "match": "(?i)([P])\\s?(\\d?\\.?\\d+\\.?|\\.?(?=[#\\[]))",
          "name": "variable.parameter.gcode"
        }
      ]
    },
    "coords": {
      "patterns": [
        {
          "match": "(?i)([ABCXYZUVW])\\s?(\\-?\\d*\\.?\\d+\\.?|\\-?\\.?(?=[#\\[]))",
          "captures": {
            "1": {
              "name": "variable.parameter.gcode"
            },
            "2": {
              "name": "constant.numeric.gcode"
            }
          },
          "name": "variable.parameter.gcode"
        }
      ]
    },
    "tools": {
      "patterns": [
        {
          "match": "(?i)([DHT])\\s?(\\d+(\\.\\d*)?|(?=[#\\[]))",
          "name": "variable.parameter.gcode"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?i)(\\d+(\\.\\d*)?)",
          "name": "constant.numeric.gcode"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "match": "(?i)([IJKQR])(\\-?\\d*\\.?\\d+\\.?|\\-?\\.?(?=[#\\[]))",
          "captures": {
            "1": {
              "name": "variable.parameter.gcode"
            },
            "2": {
              "name": "constant.numeric.gcode"
            }
          },
          "name": "variable.parameter.gcode"
        }
      ]
    },
    "macrovars": {
      "patterns": [
        {
          "match": "[#]([0-9]+)",
          "captures": {
            "1": {
              "name": "variable.name.gcode"
            }
          },
          "name": "variable.other.gcode"
        },
        {
          "match": "[#][<]([a-zA-Z0-9_]+)[>]",
          "captures": {
            "1": {
              "name": "variable.name.gcode"
            }
          },
          "name": "variable.other.gcode"
        }
      ]
    },
    "rs274ngc": {
      "patterns": [
        {
          "match": "(?i)(ENDSUB|SUB)",
          "name": "keyword.control.gcode"
        },
        {
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.tag.gcode"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.tag.gcode"
            }
          },
          "name": "meta.tag.gcode"
        }
      ]
    }
  }
}
