{
  "name": "vscode-gcode-extension",
  "displayName": "G-Code Language Support",
  "description": "G-Code language support with syntax highlighting, formatting, diagnostics, 3D visualizer, and multi-dialect IntelliSense",
  "version": "2.4.0",
  "publisher": "QuickBoyz",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/client/index.js",
  "activationEvents": [
    "onLanguage:gcode",
    "onCommand:gcode.formatDocument",
    "onCommand:gcode.openVisualizer"
  ],
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuickBoyz/vscode-gcode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/QuickBoyz/vscode-gcode-extension/issues"
  },
  "homepage": "https://github.com/QuickBoyz/vscode-gcode-extension",
  "keywords": [
    "vscode",
    "extension",
    "gcode",
    "language",
    "support",
    "syntax",
    "highlighting",
    "formatting",
    "lsp",
    "language-server"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && npm run build:webview",
    "build:webview": "node scripts/build-webview.mjs",
    "watch:webview": "node scripts/build-webview.mjs --watch",
    "build:e2e": "npm run build && rm -rf out && tsc --project tsconfig.e2e.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch",
    "test:e2e": "npm run build:e2e && rm -rf .vscode-test/user-data; vscode-test",
    "test:all": "npm run test && npm run test:e2e",
    "package": "npm run build && vsce package",
    "package:pre": "npm run build && vsce package --pre-release",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "sass": "^1.99.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gcode",
        "aliases": [
          "G-Code",
          "gcode"
        ],
        "extensions": [
          ".001",
          ".apt",
          ".aptcl",
          ".cls",
          ".cnc",
          ".din",
          ".dnc",
          ".ecs",
          ".eia",
          ".fan",
          ".fgc",
          ".fnc",
          ".g",
          ".g00",
          ".gc",
          ".gcd",
          ".gcode",
          ".gp",
          ".hnc",
          ".knc",
          ".lib",
          ".m",
          ".min",
          ".mpf",
          ".mpr",
          ".msb",
          ".nc",
          ".ncc",
          ".ncd",
          ".ncf",
          ".ncg",
          ".nci",
          ".ncp",
          ".ngc",
          ".out",
          ".pim",
          ".pit",
          ".plt",
          ".ply",
          ".prg",
          ".pu1",
          ".rol",
          ".S",
          ".sbp",
          ".spf",
          ".ssb",
          ".sub",
          ".tap",
          ".xpi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gcode",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "G-Code Theme",
        "path": "./themes/gcode-theme.json"
      }
    ],
    "commands": [
      {
        "command": "gcode.formatDocument",
        "title": "Format G-Code Document",
        "category": "G-Code"
      },
      {
        "command": "gcode.openVisualizer",
        "title": "Open 3D Visualizer",
        "category": "G-Code",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gcode.openVisualizer",
          "when": "editorLangId == gcode",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "gcode.openVisualizer",
          "when": "resourceLangId == gcode",
          "group": "navigation"
        }
      ]
    },
    "semanticTokenScopes": [
      {
        "language": "gcode",
        "scopes": {
          "variable": [
            "variable.other.readwrite",
            "entity.name.variable"
          ],
          "variable.declaration": [
            "variable.other.readwrite",
            "entity.name.variable"
          ],
          "function": [
            "entity.name.function"
          ],
          "label": [
            "entity.name.label"
          ],
          "keyword": [
            "keyword.control",
            "keyword"
          ],
          "number": [
            "constant.numeric"
          ],
          "operator": [
            "keyword.operator"
          ],
          "comment": [
            "comment.line",
            "comment.block",
            "comment"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[gcode]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "G-Code",
      "properties": {
        "gcode.dialect": {
          "type": "string",
          "enum": [
            "linuxcnc",
            "fanuc",
            "haas",
            "siemens"
          ],
          "default": "linuxcnc",
          "enumDescriptions": [
            "LinuxCNC (EMC2) - Extended G-code with named variables",
            "Fanuc - Industry standard for mills and lathes",
            "Haas - Mill-specific G-codes with extended features",
            "Siemens/Sinumerik - Extended G-code range"
          ],
          "markdownDescription": "Select the G-code dialect/flavor for completions and documentation. Different CNC controls support different command sets and syntax variations."
        },
        "gcode.formatter.addLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Add N-block line numbers to each line (N10, N20, etc.)"
        },
        "gcode.formatter.lineNumberStart": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Starting line number when adding N-blocks"
        },
        "gcode.formatter.lineNumberIncrement": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Line number increment when adding N-blocks"
        },
        "gcode.formatter.prettyPrintCommands": {
          "type": "boolean",
          "default": true,
          "description": "Pretty-print G and M codes with two digits (G1 → G01, M3 → M03)"
        },
        "gcode.formatter.prettyPrintNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Pretty-print parameter numbers to always include a decimal point (X2 → X2.0)"
        },
        "gcode.formatter.indent": {
          "type": "boolean",
          "default": true,
          "description": "Enable indentation for control structures (WHILE, IF, etc.)"
        },
        "gcode.formatter.compactOutput": {
          "type": "boolean",
          "default": false,
          "description": "Compact output mode - removes all empty lines"
        },
        "gcode.formatter.addProgramDelimiters": {
          "type": "boolean",
          "default": true,
          "description": "Add program delimiters (%) at the beginning and end of the program if not present"
        },
        "gcode.visualizer.rapidColor": {
          "type": "string",
          "default": "#ff6b6b",
          "description": "Colour for rapid (G0) moves in the 3D visualizer (CSS hex colour)"
        },
        "gcode.visualizer.feedColor": {
          "type": "string",
          "default": "#4ecdc4",
          "description": "Colour for linear feed (G1) moves in the 3D visualizer"
        },
        "gcode.visualizer.arcColor": {
          "type": "string",
          "default": "#f0e68c",
          "description": "Colour for arc (G2/G3) moves in the 3D visualizer"
        },
        "gcode.visualizer.lineThickness": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 5,
          "description": "Line thickness (pixels) for tool-path lines in the 3D visualizer"
        },
        "gcode.visualizer.showGrid": {
          "type": "boolean",
          "default": true,
          "description": "Show reference grid on the XY plane in the 3D visualizer"
        },
        "gcode.visualizer.gridSpacing": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Grid line spacing in work units (mm or inches)"
        },
        "gcode.visualizer.showRapidMoves": {
          "type": "boolean",
          "default": true,
          "description": "Show rapid (G0) moves in the 3D visualizer"
        },
        "gcode.visualizer.projection": {
          "type": "string",
          "default": "perspective",
          "enum": [
            "perspective",
            "orthographic"
          ],
          "description": "Projection mode for the 3D visualizer"
        },
        "gcode.visualizer.playback.rapidSpeed": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Rapid traverse speed in mm/min for playback animation"
        },
        "gcode.visualizer.playback.defaultFeedRate": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 100000,
          "description": "Fallback feed rate in mm/min when no F value is set in the G-code"
        },
        "gcode.visualizer.playback.followSourceLine": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scroll the editor to the current source line during playback"
        },
        "gcode.variables": {
          "type": "object",
          "default": {},
          "markdownDescription": "Global variable values for the G-code visualizer and interpreter. Keys can use any of these formats:\n- `#100` — numbered variable\n- `#<tool_diameter>` — named variable\n- `100` or `tool_diameter` — shorthand (without `#` prefix)\n\nValues must be numbers. These variables are pre-loaded before program execution, so they act as defaults that can be overwritten by assignments in the G-code program.\n\nExample:\n```json\n{\n  \"#100\": 25.4,\n  \"#<tool_diameter>\": 6.35,\n  \"#5221\": 0.0\n}\n```",
          "additionalProperties": {
            "type": "number"
          }
        },
        "gcode.workspace.indexingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable symbol indexing for Ctrl+T search across open G-code files"
        },
        "gcode.workspace.maxSymbols": {
          "type": "integer",
          "default": 10000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum number of symbols to index across all workspace files"
        }
      }
    }
  }
}
