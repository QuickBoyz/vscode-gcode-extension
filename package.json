{
  "name": "vscode-gcode-extension",
  "displayName": "G-Code Language Support",
  "description": "G-Code language support with syntax highlighting and formatting",
  "version": "1.0.0",
  "publisher": "QuickBoyz",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/client/index.js",
  "activationEvents": [
    "onLanguage:gcode",
    "onCommand:gcode.formatDocument"
  ],
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuickBoyz/vscode-gcode-extension.git"
  },
  "bugs": {
    "url": "https://github.com/QuickBoyz/vscode-gcode-extension/issues"
  },
  "homepage": "https://github.com/QuickBoyz/vscode-gcode-extension",
  "keywords": [
    "vscode",
    "extension",
    "gcode",
    "language",
    "support",
    "syntax",
    "highlighting",
    "formatting",
    "lsp",
    "language-server"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "build:e2e": "npm run build && rm -rf out && tsc --project tsconfig.e2e.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch",
    "test:e2e": "npm run build:e2e && rm -rf .vscode-test/user-data; vscode-test",
    "test:all": "npm run test && npm run test:e2e",
    "package": "npm run build && vsce package",
    "package:pre": "npm run build && vsce package --pre-release",
    "prepare": "husky"
  },
  "dependencies": {
    "moo": "^0.5.2",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/moo": "^0.5.10",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gcode",
        "aliases": [
          "G-Code",
          "gcode"
        ],
        "extensions": [
          ".001",
          ".apt",
          ".aptcl",
          ".cls",
          ".cnc",
          ".din",
          ".dnc",
          ".ecs",
          ".eia",
          ".fan",
          ".fgc",
          ".fnc",
          ".g",
          ".g00",
          ".gc",
          ".gcd",
          ".gcode",
          ".gp",
          ".hnc",
          ".knc",
          ".lib",
          ".m",
          ".min",
          ".mpf",
          ".mpr",
          ".msb",
          ".nc",
          ".ncc",
          ".ncd",
          ".ncf",
          ".ncg",
          ".nci",
          ".ncp",
          ".ngc",
          ".out",
          ".pim",
          ".pit",
          ".plt",
          ".ply",
          ".prg",
          ".pu1",
          ".rol",
          ".S",
          ".sbp",
          ".spf",
          ".ssb",
          ".sub",
          ".tap",
          ".xpi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gcode",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "G-Code Theme",
        "path": "./themes/gcode-theme.json"
      }
    ],
    "commands": [
      {
        "command": "gcode.formatDocument",
        "title": "Format G-Code Document",
        "category": "G-Code"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gcode",
        "scopes": {
          "variable": [
            "variable.other.readwrite",
            "entity.name.variable"
          ],
          "variable.declaration": [
            "variable.other.readwrite",
            "entity.name.variable"
          ],
          "function": [
            "entity.name.function"
          ],
          "label": [
            "entity.name.label"
          ],
          "keyword": [
            "keyword.control",
            "keyword"
          ],
          "number": [
            "constant.numeric"
          ],
          "operator": [
            "keyword.operator"
          ],
          "comment": [
            "comment.line",
            "comment.block",
            "comment"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[gcode]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "G-Code",
      "properties": {
        "gcode.formatter.addLineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Add N-block line numbers to each line (N10, N20, etc.)"
        },
        "gcode.formatter.lineNumberStart": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Starting line number when adding N-blocks"
        },
        "gcode.formatter.lineNumberIncrement": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Line number increment when adding N-blocks"
        },
        "gcode.formatter.prettyPrintCommands": {
          "type": "boolean",
          "default": true,
          "description": "Pretty-print G and M codes with two digits (G1 → G01, M3 → M03)"
        },
        "gcode.formatter.prettyPrintNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Pretty-print parameter numbers to always include a decimal point (X2 → X2.0)"
        },
        "gcode.formatter.indent": {
          "type": "boolean",
          "default": true,
          "description": "Enable indentation for control structures (WHILE, IF, etc.)"
        },
        "gcode.formatter.compactOutput": {
          "type": "boolean",
          "default": false,
          "description": "Compact output mode - removes all empty lines"
        },
        "gcode.formatter.addProgramDelimiters": {
          "type": "boolean",
          "default": true,
          "description": "Add program delimiters (%) at the beginning and end of the program if not present"
        }
      }
    }
  }
}
