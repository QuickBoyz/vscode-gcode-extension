{
  "name": "vscode-gcode-extension",
  "displayName": "vscode-gcode-extension",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "scripts": {
    "build:parser": "nearleyc src/lexer/gcode.ne -o src/parser/gcode.ne.ts && sed -i '1i// @ts-nocheck' src/parser/gcode.ne.ts",
    "build:tsc": "tsc --project tsconfig.build.json",
    "build": "npm run build:parser && npm run build:tsc",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/moo": "^0.5.10",
    "@types/nearley": "^2.11.5",
    "@types/node": "^25.0.3",
    "jest": "^29.7.0",
    "moo": "^0.5.2",
    "moo-ignore": "^2.5.3",
    "nearley": "^2.20.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gcode",
        "aliases": [
          "G-Code",
          "gcode"
        ],
        "extensions": [
          ".nc",
          ".ngc",
          ".g",
          ".gc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gcode",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "G-Code Theme",
        "path": "./themes/gcode-theme.json"
      }
    ]
  }
}
