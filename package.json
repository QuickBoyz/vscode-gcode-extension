{
  "name": "vscode-gcode-extension",
  "displayName": "vscode-gcode-extension",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gcode",
        "aliases": [
          "G-Code",
          "gcode"
        ],
        "extensions": [
          ".nc",
          ".ngc",
          ".g",
          ".gc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gcode",
        "scopeName": "source.gcode",
        "path": "./syntaxes/gcode.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "G-Code Theme",
        "path": "./themes/gcode-theme.json"
      }
    ]
  }
}
